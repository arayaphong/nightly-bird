local WHITE=vmath.vector4(.97,.97,1,1)
local MUTED=vmath.vector4(.62,.72,.85,1)
local ACCENT=vmath.vector4(.74,1,.35,1)
local function text(x,y,value,size,color)
    local n=gui.new_text_node(vmath.vector3(x,y,0),value)
    gui.set_font(n,'main');gui.set_scale(n,vmath.vector3(size/32,size/32,1))
    gui.set_color(n,color or WHITE);gui.set_outline(n,vmath.vector4());gui.set_shadow(n,vmath.vector4())
    return n
end
local function box(x,y,w,h,color)
    local n=gui.new_box_node(vmath.vector3(x,y,0),vmath.vector3(w,h,0));gui.set_color(n,color);return n
end
local function send(id,data) msg.post('/demo#script',id,data or {}) end
function init(self)
    msg.post('.','acquire_input_focus')
    text(240,742,'NIGHTLY BIRD',32)
    text(240,698,'RIVE · VECTOR 2D',17,ACCENT)
    text(240,655,'แตะค้างเพื่อกระพือปีก · ปล่อยเพื่อพัก',16,MUTED)
    self.blink=box(130,277,190,56,vmath.vector4(.15,.23,.38,1))
    self.chew=box(350,277,190,56,vmath.vector4(.15,.23,.38,1))
    text(130,277,'กระพริบตา',20);text(350,277,'เคี้ยว',20)
    self.hold=box(240,173,410,74,ACCENT)
    text(240,173,'แตะค้างเพื่อกระพือปีก',23,vmath.vector4(.04,.09,.12,1))
    self.status=text(240,101,'ปีก: พัก',17,MUTED)
    text(240,53,'Space: กระพือ  ·  B: ตา  ·  C: เคี้ยว',14,MUTED)
    self.pointer=false;self.keyboard=false;self.fingers={}
    local platform=sys.get_sys_info().system_name
    self.touch_device=platform=='Android' or platform=='iPhone OS'
    if html5 and html5.run then
        self.touch_device=(tonumber(html5.run('navigator.maxTouchPoints || 0')) or 0)>0
    end
end
function on_message(self,id,message)
    if id==hash('status') then gui.set_text(self.status,'ปีก: '..message.text)
    elseif id==hash('clear_input') then self.pointer=false;self.keyboard=false;self.fingers={} end
end
local function held(self)
    return self.keyboard or self.pointer or next(self.fingers)~=nil
end
function on_input(self,id,action)
    if id==hash('touch') then
        self.touch_device=true
        for _,finger in ipairs(action.touch or {}) do
            if finger.pressed then
                if gui.pick_node(self.blink,finger.x,finger.y) then send('blink')
                elseif gui.pick_node(self.chew,finger.x,finger.y) then send('chew')
                else self.fingers[finger.id]=true end
            elseif finger.released then self.fingers[finger.id]=nil end
        end
        send('flight',{held=held(self)})
        return true
    end
    if id==hash('pointer') and self.touch_device then return true end
    if action.pressed and (id==hash('blink') or id==hash('chew')) then
        send(id==hash('blink') and 'blink' or 'chew');return true
    end
    local pointer,keyboard=id==hash('pointer'),id==hash('activate')
    if not pointer and not keyboard then return false end
    if action.pressed then
        if pointer and gui.pick_node(self.blink,action.x,action.y) then send('blink');return true end
        if pointer and gui.pick_node(self.chew,action.x,action.y) then send('chew');return true end
        if pointer then self.pointer=true else self.keyboard=true end
    elseif action.released then
        if pointer then self.pointer=false else self.keyboard=false end
    end
    if action.pressed or action.released then send('flight',{held=held(self)}) end
    return true
end
