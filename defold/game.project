[project]
title = Nightly Bird
version = 0.2.1

[bootstrap]
main_collection = /main/main.collectionc

[display]
width = 480
height = 800
high_dpi = 1

[input]
game_binding = /input/game.input_bindingc

[script]
shared_state = 1

[render]
clear_color_red = 0.035
clear_color_green = 0.055
clear_color_blue = 0.10
clear_color_alpha = 1.0

[html5]
scale_mode = fit
custom_heap_size = 1
heap_size = 64

[android]
package = com.arayaphong.nightlybird.defoldhello
version_code = 3
input_method = HiddenInputField

[physics]
type = 2D
gravity_y = 0
scale = 0.01
use_fixed_timestep = 1

[engine]
fixed_update_frequency = 60

[font]
runtime_generation = 1

[native_extension]
app_manifest = /app.appmanifest
