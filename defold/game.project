[project]
title = Nightly Bird - Rive Demo
dependencies#0 = https://github.com/defold/extension-rive/archive/0283d4ecb604953057385ca5a4fae7130c776ae9.zip
version = 0.4.0

[bootstrap]
main_collection = /rive-demo/main.collectionc
render = /rive-demo/demo.renderc

[display]
width = 480
height = 800
high_dpi = 1
samples = 0

[input]
game_binding = /input/game.input_bindingc

[script]
shared_state = 1

[render]
clear_color_red = 0.035
clear_color_green = 0.055
clear_color_blue = 0.10
clear_color_alpha = 1.0

[html5]
scale_mode = fit
custom_heap_size = 1
heap_size = 64

[android]
package = com.arayaphong.nightlybird.defoldhello
version_code = 7
input_method = HiddenInputField

[physics]
type = 2D
gravity_y = 0
scale = 0.01
use_fixed_timestep = 1

[engine]
fixed_update_frequency = 60

[font]
runtime_generation = 1

[native_extension]
app_manifest = /app.appmanifest

[graphics]
opengl_version_hint = 0
vulkan_version_minor = 3

[shader]
output_spirv = 1

[rive]
render_to_texture = 1
