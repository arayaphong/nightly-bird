local state = require('game.state')
local WHITE = vmath.vector4(.96, .96, 1, 1)
local MUTED = vmath.vector4(.64, .73, .88, 1)
local ACCENT = vmath.vector4(.74, 1, .35, 1)
local function text(x, y, value, size, color)
    local n = gui.new_text_node(vmath.vector3(x, y, 0), value)
    gui.set_font(n, 'main')
    gui.set_scale(n, vmath.vector3(size / 32, size / 32, 1))
    gui.set_color(n, color or WHITE)
    gui.set_outline(n, vmath.vector4(0, 0, 0, 0))
    gui.set_shadow(n, vmath.vector4(0, 0, 0, 0))
    return n
end
local function box(x, y, width, height, color)
    local n = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(width, height, 0))
    gui.set_color(n, color)
    return n
end
local function enabled(nodes, value)
    for _, n in ipairs(nodes) do gui.set_enabled(n, value) end
end
local function send(id, message)
    msg.post('/game#controller', id, message or {})
end

function init(self)
    msg.post('.', 'acquire_input_focus')
    self.score = text(80, 760, '0 m', 26)
    self.best = text(100, 726, '', 14, MUTED)
    self.agi = text(230, 761, '', 16, ACCENT)
    self.skips = text(238, 732, '', 13, MUTED)
    self.pause = box(425, 751, 68, 48, vmath.vector4(.12, .18, .32, .9))
    self.pause_label = text(425, 751, 'หยุด', 16)
    self.boost = text(240, 675, '', 20, ACCENT)
    self.warning = text(240, 211, 'บินให้สูงเพื่อเติมแรงเด้งน้ำ', 15, vmath.vector4(1, .68, .5, 1))
    self.ready = {
        text(240, 608, 'NIGHTLY BIRD', 40),
        text(240, 568, 'นกน้อยในคืนดาวพราว', 18, MUTED),
        box(240, 332, 340, 64, vmath.vector4(.74, 1, .35, 1)),
        text(240, 332, 'แตะค้างเพื่อเริ่มบิน', 23, vmath.vector4(.05, .1, .12, 1)),
        text(240, 276, 'ปล่อยเพื่อลดระดับ · เก็บหิ่งห้อยเพิ่มพลัง', 15, MUTED),
        text(240, 248, 'คีย์บอร์ด: Space บิน · P หยุดเกม', 14, MUTED),
    }
    self.shade = box(240, 400, 480, 800, vmath.vector4(.01, .025, .07, .78))
    self.panel = box(240, 410, 414, 330, vmath.vector4(.055, .09, .18, .98))
    self.title = text(240, 515, '', 32)
    self.result = text(240, 465, '', 20, MUTED)
    self.primary = box(240, 385, 330, 62, ACCENT)
    self.primary_label = text(240, 385, '', 22, vmath.vector4(.05, .1, .12, 1))
    self.secondary = box(240, 308, 330, 48, vmath.vector4(.12, .19, .31, 1))
    self.secondary_label = text(240, 308, 'เริ่มใหม่', 18)
    self.overlay = {self.shade, self.panel, self.title, self.result, self.primary,
                    self.primary_label, self.secondary, self.secondary_label}
    enabled(self.overlay, false)
    self.pointer, self.keyboard = false, false
end

function update(self, dt)
    if self.last_phase ~= state.phase then
        if state.phase ~= 'play' then self.pointer, self.keyboard = false, false end
        self.last_phase = state.phase
    end
    gui.set_text(self.score, state.score .. ' m')
    gui.set_text(self.best, 'ไกลที่สุด ' .. state.best .. ' m')
    gui.set_text(self.agi, string.format('AGI %.2f', state.agi))
    gui.set_text(self.skips, 'เด้งน้ำ ' .. state.skips .. '/3')
    gui.set_text(self.boost, state.boost > 0 and string.format('ความเร็ว ×4  %.1f s', state.boost) or '')
    gui.set_enabled(self.warning, state.phase == 'play' and state.y < 290)
    enabled(self.ready, state.phase == 'ready')
    gui.set_enabled(self.pause, state.phase == 'play')
    gui.set_enabled(self.pause_label, state.phase == 'play')
    local paused, over = state.phase == 'paused', state.phase == 'over'
    enabled(self.overlay, paused or over)
    if paused or over then
        gui.set_text(self.title, paused and 'หยุดพักสักครู่' or 'จบการบิน')
        gui.set_text(self.result, paused and 'พร้อมแล้วค่อยบินต่อ' or (state.score .. ' m · เก็บหิ่งห้อย ' .. state.collected .. ' ตัว'))
        gui.set_text(self.primary_label, paused and 'บินต่อ' or 'บินอีกครั้ง')
        gui.set_enabled(self.secondary, paused)
        gui.set_enabled(self.secondary_label, paused)
    end
end

function on_input(self, action_id, action)
    if (action_id == hash('pause') or action_id == hash('escape')) and action.pressed then
        self.pointer, self.keyboard = false, false
        send('pause')
        return true
    end
    local pointer, keyboard = action_id == hash('pointer'), action_id == hash('activate')
    if not pointer and not keyboard then return false end
    if action.pressed then
        if state.phase == 'paused' or state.phase == 'over' then
            if keyboard or gui.pick_node(self.primary, action.x, action.y) then
                send(state.phase == 'paused' and 'pause' or 'restart')
            elseif state.phase == 'paused' and gui.pick_node(self.secondary, action.x, action.y) then
                send('restart')
            end
            return true
        end
        if pointer and state.phase == 'play' and gui.pick_node(self.pause, action.x, action.y) then
            self.pointer, self.keyboard = false, false
            send('pause')
            return true
        end
        if pointer then self.pointer = true else self.keyboard = true end
    elseif action.released then
        if pointer then self.pointer = false else self.keyboard = false end
    end
    if action.pressed or action.released then
        send('flight', {held = self.pointer or self.keyboard})
    end
    return true
end
