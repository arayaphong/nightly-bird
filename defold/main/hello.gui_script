local WHITE = vmath.vector4(0.94, 0.96, 1.0, 1.0)
local MUTED = vmath.vector4(0.57, 0.65, 0.78, 1.0)
local ACCENT = vmath.vector4(0.40, 0.90, 0.73, 1.0)
local INK = vmath.vector4(0.035, 0.055, 0.10, 1.0)

local function text(id, value, y, scale, color)
    local node = gui.new_text_node(vmath.vector3(480, y, 0), value)
    gui.set_id(node, id)
    gui.set_font(node, "default")
    gui.set_scale(node, vmath.vector3(scale, scale, 1))
    gui.set_color(node, color)
    gui.set_outline(node, vmath.vector4(0, 0, 0, 0))
    gui.set_shadow(node, vmath.vector4(0, 0, 0, 0))
    return node
end

function init(self)
    msg.post(".", "acquire_input_focus")
    self.count = 0
    text("eyebrow", "NIGHTLY BIRD / DEFOLD", 466, 0.65, ACCENT)
    text("title", "Hello, world!", 392, 1.65, WHITE)
    text("subtitle", "A small beginning. Built with Lua.", 338, 0.7, MUTED)

    self.button = gui.new_box_node(vmath.vector3(480, 250, 0), vmath.vector3(300, 66, 0))
    gui.set_id(self.button, "button")
    gui.set_color(self.button, ACCENT)
    text("button_label", "SAY HELLO", 250, 0.8, INK)
    self.counter = text("counter", "Hellos: 0", 184, 0.8, WHITE)
    text("hint", "Click / tap the button, or press Space", 138, 0.6, MUTED)
    text("footer", "Defold 1.14.0  |  HTML5 / WebAssembly", 48, 0.5, MUTED)
    print("HELLO_READY")
end

function on_input(self, action_id, action)
    if not action.pressed then return end
    local keyboard = action_id == hash("activate")
    local pointer = action_id == hash("pointer")
        and gui.pick_node(self.button, action.x, action.y)
    if keyboard or pointer then
        self.count = self.count + 1
        gui.set_text(self.counter, "Hellos: " .. self.count)
        gui.set_color(self.button, WHITE)
        gui.animate(self.button, "color", ACCENT, gui.EASING_OUTQUAD, 0.2)
        print("HELLO_COUNT " .. self.count)
        return true
    end
end
