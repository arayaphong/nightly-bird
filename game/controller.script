local rules = require('game.rules')
local state = require('game.state')
local function stop_flap(self)
    state.held = false
    if self.flap_voice then sound.stop('#wing'); self.flap_voice = false end
end

local function save_best(self)
    if state.best > self.saved_best then
        local ok = sys.save(self.save_path, {best = state.best})
        if ok then self.saved_best = state.best end
    end
end

local function focus(self, event)
    if event == window.WINDOW_EVENT_FOCUS_LOST then
        stop_flap(self)
        if state.phase == 'play' then rules.pause(state) end
    end
end

function init(self)
    self.save_path = sys.get_save_file('nightly-bird', 'progress')
    local saved = sys.load(self.save_path)
    state.best = tonumber(saved.best) or 0
    self.saved_best = state.best
    rules.reset(state)
    self.pose, self.wing_time, self.flap_voice = '', 0, false
    msg.post('@render:', 'use_fixed_fit_projection', {near = -1, far = 1})
    window.set_listener(focus)
    print('NIGHTLY_READY')
end

local function animate_bird(self, dt)
    if state.phase == 'paused' then
        go.set('/bird#sprite', 'playback_rate', 0)
        return
    end
    local pose
    if state.phase == 'dead' or state.phase == 'over' then pose = 'dead'
    elseif state.held then pose = 'flap'
    elseif state.chew > 0 and math.sin(state.chew * math.pi * 5) > 0 then pose = 'chew'
    elseif state.time % 4 > 3.82 then pose = 'blink'
    else pose = 'idle' end
    if pose ~= self.pose then
        sprite.play_flipbook('/bird#sprite', pose)
        self.pose = pose
    end
    go.set_position(vmath.vector3(state.x, state.y, .2), '/bird')
    local angle = math.max(-.8, math.min(.6, state.vy / 1120))
    if state.phase == 'dead' or state.phase == 'over' then angle = -.47 end
    go.set_rotation(vmath.quat_rotation_z(angle), '/bird')
    if state.phase == 'play' and state.held then
        self.wing_time = self.wing_time - dt
        if self.wing_time <= 0 then
            sound.play('#wing', {gain = .3})
            self.flap_voice, self.wing_time = true, .57
        end
    else
        self.wing_time = 0
    end
    go.set('/bird#sprite', 'playback_rate', 1)
end

local function spawn(self)
    local count = math.random(1, 3)
    local y = 224 + math.random() * 480
    for i = 1, count do
        factory.create('#fireflies', vmath.vector3(480 + 20 + (i - 1) * 28, y + (math.random() - .5) * 50, .3), nil,
            {rainbow = math.random() < .2, phase = math.random() * 6})
    end
    state.spawn_timer = 2 + math.random() * 3
end

function fixed_update(self, dt)
    local event = rules.step(state, dt)
    if event == 'bounce' then
        sound.play('#bounce')
        print('WATER_BOUNCE ' .. state.skips)
    elseif event == 'drown' then
        stop_flap(self)
        sound.play('#sink')
        print('DROWN')
    elseif event == 'game_over' then
        save_best(self)
        print('GAME_OVER ' .. state.score)
    end
    if state.phase == 'play' then
        state.spawn_timer = state.spawn_timer - dt
        if state.spawn_timer <= 0 then spawn(self) end
    end
    animate_bird(self, dt)
end

function on_message(self, id, message)
    if id == hash('flight') then
        if message.held and (state.phase == 'ready' or state.phase == 'over') then
            rules.start(state)
            print('RUN_STARTED')
        end
        state.held = state.phase == 'play' and message.held
    elseif id == hash('pause') then
        stop_flap(self)
        rules.pause(state)
        save_best(self)
        print('PHASE ' .. state.phase)
    elseif id == hash('restart') then
        save_best(self)
        stop_flap(self)
        rules.start(state)
        print('RUN_STARTED')
    elseif id == hash('collected') then
        sound.play('#crunch')
        print('PICKUP ' .. state.collected .. ' AGI ' .. state.agi .. ' BOOST ' .. state.boost)
    end
end

function final(self)
    save_best(self)
    window.set_listener(nil)
end
