local motion=require('shared.characters.hawk.motion')
local function publish(self)
    local busy=self.motion.remaining>0
    local seconds=math.ceil(self.motion.remaining)
    if busy~=self.busy or seconds~=self.seconds then
        self.busy,self.seconds=busy,seconds
        msg.post('/ui#gui','hawk_status',{busy=busy,seconds=seconds})
    end
end
local function cancel(self)
    motion.cancel(self.motion);sound.stop('#strike');publish(self)
end
function init(self)
    self.motion=motion.new();self.last={};self.active=false
    msg.post('#hawk','disable')
end
function update(self,dt)
    local p=rive.get_projection_matrix()
    local w,h=2/p.m00,2/p.m11
    if w~=self.width or h~=self.height then
        self.width,self.height=w,h
        local scale=math.min(w/480,h/800)
        go.set_scale(vmath.vector3(.18*scale,.18*scale,1))
        go.set_position(vmath.vector3(w/2,h/2+70*scale,0))
    end
    if not self.active then return end
    -- Use the full elapsed frame time: a three-second action must not slow
    -- down on a low-frame-rate device. Motion partitions the recovery frame.
    motion.step(self.motion,dt);publish(self)
    if not self.vm then self.vm=rive.get_view_model_instance('#hawk') end
    if self.vm then
        for name,value in pairs(motion.values(self.motion)) do
            if value~=self.last[name] then
                rive.cmd.setViewModelInstanceNumber(self.vm,name,value);self.last[name]=value
            end
        end
    end
end
function on_message(self,id,message)
    if id==hash('active') then
        self.active=message.active
        if not self.active then cancel(self) end
        msg.post('#hawk',self.active and 'enable' or 'disable');publish(self)
    elseif id==hash('cancel') then cancel(self)
    elseif id==hash('dive') and self.active and motion.dive(self.motion) then
        sound.stop('#strike');sound.play('#strike');publish(self)
    end
end
