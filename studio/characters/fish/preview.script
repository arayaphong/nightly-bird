local motion=require('shared.characters.fish.motion')
function init(self)
    self.motion=motion.new();self.last={};self.active=false
    msg.post('#fish','disable')
end
function update(self,dt)
    local p=rive.get_projection_matrix()
    local w,h=2/p.m00,2/p.m11
    if w~=self.width or h~=self.height then
        self.width,self.height=w,h
        local scale=math.min(w/480,h/800)
        go.set_scale(vmath.vector3(.24*scale,.24*scale,1))
        go.set_position(vmath.vector3(w/2,h/2+80*scale,0))
    end
    if not self.active then return end
    motion.step(self.motion,math.min(dt,.033))
    if not self.vm then self.vm=rive.get_view_model_instance('#fish') end
    if self.vm then
        for name,value in pairs(motion.values(self.motion)) do
            if value~=self.last[name] then
                rive.cmd.setViewModelInstanceNumber(self.vm,name,value);self.last[name]=value
            end
        end
    end
    local status=self.motion.turning and 'กำลังกลับตัว' or (self.motion.direction==1 and 'หันขวา' or 'หันซ้าย')
    if status~=self.status then
        self.status=status;msg.post('/ui#gui','fish_status',{text=status})
    end
end
function on_message(self,id,message)
    if id==hash('active') then
        self.active=message.active
        msg.post('#fish',self.active and 'enable' or 'disable')
    elseif id==hash('turn') and self.active then motion.turn(self.motion) end
end
