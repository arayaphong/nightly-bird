local viewport=require('shared.display.viewport')
local layouts=require('shared.display.layouts')
local gestures=require('shared.input.gestures')
local pages=require('app.routes')
local WHITE=vmath.vector4(.97,.97,1,1)
local MUTED=vmath.vector4(.62,.72,.85,1)
local ACCENT=vmath.vector4(.74,1,.35,1)
local DOT_INACTIVE=vmath.vector4(.25,.34,.46,1)
local PAGES=pages.order
local CHARACTER_LABELS={'นกแดง','ปลา','เหยี่ยว','หิ่งห้อย','ลูกโป่ง','เมฆฝน'}
local SELECT_KEYS={'magnet','gun','helmet','suit','select5','select6'}
local ITEMS={'magnet','gun','helmet','suit'}
local LABELS={'แม่เหล็ก','ปืนเลเซอร์','หมวกนิรภัย','ชุดกันฟ้าผ่า'}
local function text(x,y,value,size,color)
    local n=gui.new_text_node(vmath.vector3(x,y,0),value)
    gui.set_font(n,'main');gui.set_scale(n,vmath.vector3(size/32,size/32,1))
    gui.set_color(n,color or WHITE);gui.set_outline(n,vmath.vector4());gui.set_shadow(n,vmath.vector4())
    return n
end
local function box(x,y,w,h,color)
    local n=gui.new_box_node(vmath.vector3(x,y,0),vmath.vector3(w,h,0));gui.set_color(n,color);return n
end
local function group()
    local root=box(viewport.UI_WIDTH/2,viewport.UI_HEIGHT/2,viewport.UI_WIDTH,viewport.UI_HEIGHT,vmath.vector4())
    local function add_text(...)
        local n=text(...);gui.set_parent(n,root,true);gui.set_inherit_alpha(n,false);return n
    end
    local function add_box(...)
        local n=box(...);gui.set_parent(n,root,true);gui.set_inherit_alpha(n,false);return n
    end
    return root,add_text,add_box
end
local function send(id,data) msg.post('/red_bird#script',id,data or {}) end
local function clear_input(self)
    self.keyboard=false;self.fingers={};self.gestures=gestures.new()
end
local function update_page_dots(self)
    local selected=pages.index(self.page)
    for i,node in ipairs(self.page_dots) do
        gui.set_enabled(node,selected~=nil)
        local diameter=i==selected and 10 or 8
        gui.set_size(node,vmath.vector3(diameter,diameter,0))
        gui.set_color(node,i==selected and ACCENT or DOT_INACTIVE)
    end
end
local function apply_route(self,page)
    self.page=page;clear_input(self)
    for _,name in ipairs(PAGES) do gui.set_enabled(self[name..'_root'],page==name) end
    gui.set_enabled(self.home_root,page=='characters')
    update_page_dots(self)
end
local function set_page(self,page)
    if self.page~=page and pages.valid(page) then msg.post('/navigation#script','navigate',{name=page}) end
end
local function move_page(self,direction)
    local next_page=pages.neighbor(self.page,direction)
    if next_page then set_page(self,next_page) end
end
local function build(self)
    local saved={};local fields={'status','fish_status','hawk_status','dive_label','lightning_label','dive','lightning'}
    for _,key in ipairs(fields) do
        local n=self[key]
        if n then saved[key]={text=(key~='dive' and key~='lightning') and gui.get_text(n),color=gui.get_color(n)} end
    end
    local badges={}
    for key,n in pairs(self.badges or {}) do badges[key]={text=gui.get_text(n),color=gui.get_color(n)} end
    if self.home_root then
        gui.delete_node(self.home_root)
        for _,name in ipairs(PAGES) do gui.delete_node(self[name..'_root']) end
        for _,n in ipairs(self.page_dots) do gui.delete_node(n) end
    end
    viewport.apply_gui()
    layouts[viewport.mode].characters(self,{group=group,update_page_dots=update_page_dots,
        WHITE=WHITE,MUTED=MUTED,ACCENT=ACCENT,PAGES=PAGES,CHARACTER_LABELS=CHARACTER_LABELS,ITEMS=ITEMS,LABELS=LABELS})
    for key,value in pairs(saved) do
        if value.text then gui.set_text(self[key],value.text) end
        gui.set_color(self[key],value.color)
    end
    for key,value in pairs(badges) do gui.set_text(self.badges[key],value.text);gui.set_color(self.badges[key],value.color) end
    self.layout_mode=viewport.mode;apply_route(self,self.page or 'home')
end
function init(self)
    msg.post('.','acquire_input_focus');self.page='home';self.hawk_busy=false;self.cloud_busy=false;clear_input(self);build(self)
    local platform=sys.get_sys_info().system_name
    self.touch_device=platform=='Android' or platform=='iPhone OS'
    if html5 and html5.run then self.touch_device=(tonumber(html5.run('navigator.maxTouchPoints || 0')) or 0)>0 end
end
function on_message(self,id,message)
    if id==hash('apply_display_profile') then gui.set_layout(viewport.mode);return end
    if id==hash('display_orientation') then build(self)
    elseif id==hash('route') then apply_route(self,message.name)
    elseif id==hash('status') then gui.set_text(self.status,'ปีก: '..message.text)
    elseif id==hash('fish_status') then gui.set_text(self.fish_status,message.text)
    elseif id==hash('hawk_status') then
        self.hawk_busy=message.busy
        local facing=message.turning and 'กำลังกลับตัว' or (message.direction==1 and 'หันขวา' or 'หันซ้าย')
        gui.set_text(self.hawk_status,(message.busy and 'กำลังพุ่งตัว' or 'กำลังบิน')..' · '..facing)
        gui.set_text(self.dive_label,message.busy and ('กำลังพุ่ง · '..message.seconds) or 'พุ่งตัว')
        gui.set_color(self.dive,message.busy and vmath.vector4(.15,.23,.38,1) or ACCENT)
        gui.set_color(self.dive_label,message.busy and MUTED or vmath.vector4(.04,.09,.12,1))
    elseif id==hash('cloud_status') then
        self.cloud_busy=message.busy
        gui.set_text(self.lightning_label,message.busy and 'กำลังฟ้าแลบ' or 'ฟ้าแลบ')
        gui.set_color(self.lightning,message.busy and vmath.vector4(.15,.23,.38,1) or ACCENT)
        gui.set_color(self.lightning_label,message.busy and MUTED or vmath.vector4(.04,.09,.12,1))
    elseif id==hash('equipment_state') then
        local badge=self.badges[message.item]
        if badge then
            gui.set_text(badge,message.enabled and 'เปิด' or 'ปิด')
            gui.set_color(badge,message.enabled and ACCENT or MUTED)
        end
    elseif id==hash('clear_input') then clear_input(self) end
end
local function button_at(self,x,y)
    if self.page=='characters' then
        for _,name in ipairs(PAGES) do if gui.pick_node(self.cards[name],x,y) then return 'select:'..name end end
        return nil
    end
    if self.page=='fish' then return gui.pick_node(self.turn,x,y) and 'turn' or nil end
    if self.page=='hawk' then
        if gui.pick_node(self.hawk_turn,x,y) then return 'hawk_turn' end
        return not self.hawk_busy and gui.pick_node(self.dive,x,y) and 'dive' or nil
    end
    if self.page=='cloud' then return not self.cloud_busy and gui.pick_node(self.lightning,x,y) and 'lightning' or nil end
    if self.page~='bird' then return nil end
    for _,key in ipairs(ITEMS) do if gui.pick_node(self.items[key],x,y) then return key end end
    if gui.pick_node(self.blink,x,y) then return 'blink' end
    if gui.pick_node(self.chew,x,y) then return 'chew' end
end
local function activate(self,button)
    if button=='home' then set_page(self,'characters')
    elseif button:sub(1,7)=='select:' then set_page(self,button:sub(8))
    elseif button=='turn' then msg.post('/fish#script','turn')
    elseif button=='hawk_turn' then msg.post('/hawk#script','turn')
    elseif button=='dive' then if not self.hawk_busy then msg.post('/hawk#script','dive') end
    elseif button=='lightning' then if not self.cloud_busy then msg.post('/objects#script','lightning') end
    elseif button=='blink' or button=='chew' then send(button)
    else send('toggle_equipment',{item=button}) end
end
local function flight(self)
    if self.page=='bird' then send('flight',{held=self.keyboard or next(self.fingers)~=nil}) end
end
local function pointer(self,id,action)
    local x,y=action.x,action.y
    if not x or not y then return end
    if action.pressed then
        local button=button_at(self,x,y)
        gestures.begin(self.gestures,id,x,y,button)
        if self.page=='bird' and not button then self.fingers[id]=true end
    end
    local contact=gestures.move(self.gestures,id,x,y)
    if contact and contact.horizontal then self.fingers[id]=nil end
    if action.released then
        local result=gestures.finish(self.gestures,id,x,y)
        self.fingers[id]=nil
        if result.swipe then move_page(self,-result.swipe)
        elseif result.tap then activate(self,result.tap) end
    end
    flight(self)
end
function on_input(self,id,action)
    if id==hash('escape') then return false end
    if self.page~='characters' and not pages.index(self.page) then return false end
    if id==hash('touch') then
        self.touch_device=true
        for _,finger in ipairs(action.touch or {}) do pointer(self,finger.id,finger) end
        return true
    end
    if id==hash('pointer') or (id==nil and self.gestures.mouse) then
        if self.touch_device then return true end
        pointer(self,'mouse',action);return true
    end
    if action.pressed and id==hash('next_page') then move_page(self,1);return true end
    if action.pressed and id==hash('previous_page') then move_page(self,-1);return true end
    if self.page=='characters' then
        if action.pressed then
            for i,key in ipairs(SELECT_KEYS) do if id==hash(key) then set_page(self,PAGES[i]);return true end end
        end
        return true
    end
    if self.page=='fish' or self.page=='hawk' or self.page=='cloud' then
        if self.page=='hawk' and id==hash('turn') and action.pressed then activate(self,'hawk_turn') end
        if id==hash('activate') and action.pressed then
            activate(self,({fish='turn',hawk='dive',cloud='lightning'})[self.page])
        end
        return true
    end
    if self.page~='bird' then return true end
    for _,key in ipairs(ITEMS) do
        if id==hash(key) then if action.pressed then activate(self,key) end;return true end
    end
    if action.pressed and (id==hash('blink') or id==hash('chew')) then
        activate(self,id==hash('blink') and 'blink' or 'chew');return true
    end
    if id==hash('activate') then
        if action.pressed then self.keyboard=true elseif action.released then self.keyboard=false end
        flight(self);return true
    end
    return false
end
