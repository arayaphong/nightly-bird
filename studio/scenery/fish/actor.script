local swim=require('shared.scenery.fish.motion')
local anchors=require('shared.characters.fish.anchors')
local viewport=require('shared.display.viewport')
local attack=require('shared.scenery.fish.attack')
local mouth=require('shared.scenery.fish.mouth')
local bird=require('shared.characters.red_bird.motion')
local equipment=require('shared.items.equipment')
local write_only=require('shared.render.write_only_view_model')
local dead=bird.values(bird.new())
for k,v in pairs(equipment.values(equipment.new())) do dead[k]=v end
dead.eye_normal=0;dead.eye_white=0;dead.eye_lid=0;dead.eye_dead=1
local function show_target(self,value)
    if self.target_visible==value then return end
    self.target_visible=value;msg.post('/fish_target#bird',value and 'enable' or 'disable')
end
function init(self)
    self.motion=swim.new();self.active=false;self.last={};self.visible=false
    msg.post('#fish','disable')
    msg.post('/fish_target#bird','disable')
    self.target_visible=false;self.suspended=true
    self.target_binding=write_only.new(rive,'/fish_target#bird',dead,'eye_dead')
end
function update(self)
    local vm=write_only.prepare(self.target_binding)
    if vm and not self.target_initialized then
        for k,v in pairs(dead) do rive.cmd.setViewModelInstanceNumber(vm,k,v) end
        self.target_initialized=true
    end
end
local function cancel(self)
    attack.cancel(self.motion);sound.stop('#strike')
    show_target(self,false)
end
local function target(self,camera,m)
    local p=self.motion.target
    show_target(self,p~=nil)
    if not p then return end
    local x,y,angle,belly,size,depth=mouth.target(self.motion)
    local scale=size*camera.scale;local c,s=math.cos(angle),math.sin(angle)
    -- Defold requires positive GO scale. A half turn about X reflects the
    -- bird's Y axis in the 2D plane without aborting left-facing frames.
    go.set_scale(vmath.vector3(scale,scale,1),'/fish_target')
    local rotation=vmath.quat_rotation_z(-angle)
    if belly<0 then rotation=rotation*vmath.quat_rotation_x(math.pi) end
    go.set_rotation(rotation,'/fish_target')
    -- Rotate the complete SVG bird's body-anchor offset with the fish.
    go.set_position(vmath.vector3((x-viewport.WIDTH/2)*camera.scale+m.width/2-(20*c-78*belly*s)*scale,
        (viewport.HEIGHT-y)*camera.scale+(20*s+78*belly*c)*scale,depth),'/fish_target')
end
local function visible(self,value)
    if value~=self.visible then self.visible=value;msg.post('#fish',value and 'enable' or 'disable') end
end
function on_message(self,id,m)
    if id==hash('active') then
        self.active=m.active
        -- Wait for the active water presenter before showing or resuming the fish.
        if not self.active then visible(self,false);cancel(self);self.frame=nil;self.suspended=true end
    elseif id==hash('place_target') and self.active and self.visible and self.frame then
        local frame=self.frame;local camera=viewport.camera(frame.width,frame.height)
        if self.motion.mode~='attack' then sound.stop('#strike') end
        local valid=swim.place(self.motion,m.x,m.y,frame,camera.width)
        target(self,camera,frame)
        if valid then
            print('FISH_TARGET '..m.x..' '..m.y)
        end
    elseif id==hash('water_frame') and self.active then
        m.wave_time=m.wave_time or 0;self.frame=m
        if m.visible==false then
            visible(self,false)
            if not self.suspended then cancel(self);self.suspended=true end
            return
        end
        self.suspended=false
        local camera=viewport.camera(m.width,m.height)
        if swim.step(self.motion,m.dt,m,camera.width) then
            sound.stop('#strike');sound.play('#strike');print('FISH_STRIKE')
        end
        visible(self,self.motion.visible)
        if not self.visible then cancel(self);return end
        target(self,camera,m)
        msg.post('/fish_test#script','fish_emitters',anchors.emitters(self.motion,swim.values(self.motion)))
        local scale=self.motion.scale*camera.scale
        go.set_scale(vmath.vector3(scale,scale,1))
        -- Rive's render pass draws this depth after the opaque scenery.
        go.set_position(vmath.vector3((self.motion.x-viewport.WIDTH/2)*camera.scale+m.width/2,(viewport.HEIGHT-self.motion.y)*camera.scale,-.1))
        if not self.vm then self.vm=rive.get_view_model_instance('#fish') end
        if self.vm then
            for name,value in pairs(swim.values(self.motion)) do
                if self.last[name]~=value then rive.cmd.setViewModelInstanceNumber(self.vm,name,value);self.last[name]=value end
            end
        end
    end
end
