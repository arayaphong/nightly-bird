local gestures=require('shared.input.gestures')
local sky=require('shared.scenery.night_sky.motion')
local water=require('shared.scenery.water.motion')
local WHITE=vmath.vector4(.94,.97,1,1)
local MUTED=vmath.vector4(.62,.72,.85,1)
local ACCENT=vmath.vector4(.74,1,.35,1)
local DARK=vmath.vector4(.04,.08,.12,1)
local PANEL=vmath.vector4(.045,.085,.13,.98)
local BUTTON=vmath.vector4(.085,.14,.21,1)
local function box(x,y,w,h,color)
    local n=gui.new_box_node(vmath.vector3(x,y,0),vmath.vector3(w,h,0));gui.set_color(n,color);return n
end
local function text(x,y,value,size,color)
    local n=gui.new_text_node(vmath.vector3(x,y,0),value)
    gui.set_font(n,'main');gui.set_scale(n,vmath.vector3(size/32,size/32,1))
    gui.set_color(n,color or WHITE);gui.set_outline(n,vmath.vector4());gui.set_shadow(n,vmath.vector4())
    return n
end
local function child(n,parent)
    gui.set_parent(n,parent,true);gui.set_inherit_alpha(n,false);return n
end
local function line(parent,x,y,x1,y1,x2,y2,color)
    local n=child(box(x+(x1+x2)/2,y+(y1+y2)/2,
        math.sqrt((x2-x1)^2+(y2-y1)^2),2,color),parent)
    gui.set_rotation(n,vmath.vector3(0,0,math.deg(math.atan2(y2-y1,x2-x1))));return n
end
local function arrow(parent,x,y,angle,color)
    local c,s=math.cos(angle),math.sin(angle)
    local function segment(x1,y1,x2,y2)
        return line(parent,x,y,x1*c-y1*s,x1*s+y1*c,x2*c-y2*s,x2*s+y2*c,color)
    end
    return {segment(-12,0,12,0),segment(12,0,3,6),segment(12,0,3,-6)}
end
local function slider(parent,x,y,maximum)
    local s={root=child(box(x,y+12,300,76,vmath.vector4()),parent)}
    s.label=child(text(x,y+34,'',20,WHITE),s.root)
    s.hit=child(box(x,y,260,44,vmath.vector4()),s.root)
    child(box(x,y,230,4,vmath.vector4(.2,.3,.4,1)),s.root)
    s.fill=child(box(x,y,1,4,ACCENT),s.root)
    s.knob=child(gui.new_pie_node(vmath.vector3(x,y,0),vmath.vector3(22,22,0)),s.root)
    gui.set_color(s.knob,ACCENT)
    child(text(x-143,y,maximum and '0' or '0%',15,MUTED),s.root)
    child(text(x+144,y,maximum and tostring(maximum) or '100%',15,MUTED),s.root)
    return s
end
local function update_slider(s,value,caption,enabled)
    gui.set_enabled(s.root,enabled)
    gui.set_text(s.label,caption..math.floor(value*100+.5)..'%')
    local width=230*value
    gui.set_position(s.knob,vmath.vector3(-115+width,-12,0))
    gui.set_position(s.fill,vmath.vector3(-115+width/2,-12,0))
    gui.set_size(s.fill,vmath.vector3(math.max(1,width),4,0));gui.set_enabled(s.fill,value>0)
end
local function clear(self) self.contacts={};self.gestures=gestures.new();self.slider_id=nil;self.slider_kind=nil end
local function angle_label(step)
    local value=sky.angles[step];return (value>0 and '+' or '')..value..'°'
end
local function refresh(self)
    local fish_test=self.page=='fish_test'
    gui.set_enabled(self.root,self.active)
    gui.set_enabled(self.body,not fish_test and not self.collapsed)
    gui.set_enabled(self.header,not fish_test)
    for _,n in ipairs({self.star_speed_button,self.star_speed_label,self.star_speed_hint}) do gui.set_enabled(n,not fish_test) end
    for _,n in ipairs(self.visibility_nodes) do gui.set_enabled(n,fish_test) end
    gui.set_text(self.water_toggle_label,self.water_visible and 'ปิดน้ำพร้อมปลา' or 'เปิดน้ำพร้อมปลา')
    gui.set_text(self.fish_toggle_label,self.fish_visible and 'ปิดเฉพาะปลา' or 'เปิดเฉพาะปลา')
    gui.set_color(self.fish_toggle_label,self.water_visible and WHITE or MUTED)
    -- The header is a child of the full-screen root centered at (640,360).
    gui.set_position(self.header,vmath.vector3(0,self.collapsed and -332 or -132,0))
    gui.set_text(self.current,(self.side==-1 and 'ซ้าย ' or 'ขวา ')..angle_label(self.step))
    gui.set_text(self.star_speed_label,'ความเร็วดาว: '..self.star_speed..' หน่วย/วิ')
    gui.set_color(self.star_speed_label,self.star_speed==sky.STAR_SPEEDS[2] and ACCENT or WHITE)
    update_slider(self.level_slider,self.water_level,'ระดับน้ำ: ',self.page=='night_water')
    update_slider(self.rough_slider,self.water_roughness,'ความสูง/ปั่นป่วนคลื่น: ',self.page=='night_water')
    local counts=self.page=='night_sky' or self.page=='night_water'
    local count_y=self.page=='night_water' and 490 or 590
    gui.set_position(self.star_slider.root,vmath.vector3(0,count_y+12-360,0))
    gui.set_position(self.dust_slider.root,vmath.vector3(410,count_y+12-360,0))
    update_slider(self.star_slider,self.star_count/sky.MAX_STARS,'',counts)
    update_slider(self.dust_slider,self.dust_count/sky.MAX_DUST,'',counts)
    gui.set_text(self.star_slider.label,'ดาว: '..self.star_count..(self.star_count==0 and ' (ปิด)' or ' ดวง'))
    gui.set_text(self.dust_slider.label,'ฝุ่น: '..self.dust_count..(self.dust_count==0 and ' (ปิด)' or ' เม็ด'))
    local a=math.rad(sky.angles[self.step]);a=math.atan2(math.sin(a),self.side*math.cos(a))
    gui.set_rotation(self.current_arrow,vmath.vector3(0,0,math.deg(a)))
    for _,n in ipairs(self.chevron_up) do gui.set_enabled(n,self.collapsed) end
    for _,n in ipairs(self.chevron_down) do gui.set_enabled(n,not self.collapsed) end
    for _,button in ipairs(self.buttons) do
        local selected=button.side==self.side and button.step==self.step
        gui.set_color(button.node,selected and ACCENT or BUTTON)
        gui.set_color(button.label,selected and DARK or WHITE)
        for _,n in ipairs(button.arrow) do gui.set_color(n,selected and DARK or WHITE) end
    end
end
local function select(self,side,step)
    self.side,self.step=side,step;refresh(self)
    msg.post(self.target,'wind',{side=side,step=step})
end
function init(self)
    msg.post('.','acquire_input_focus')
    self.active=false;self.collapsed=true;self.side=-1;self.step=3;self.star_speed=sky.STAR_SPEEDS[1];self.buttons={};clear(self)
    self.water_level=water.DEFAULT_LEVEL;self.water_roughness=water.DEFAULT_ROUGHNESS
    self.star_count=sky.MAX_STARS;self.dust_count=sky.MAX_DUST
    self.water_visible=true;self.fish_visible=true
    self.root=box(640,360,1280,720,vmath.vector4())
    self.title=child(text(640,668,'ท้องฟ้ากลางคืน',26,WHITE),self.root)
    child(text(640,641,'STUDIO · SCENERY',12,MUTED),self.root)
    self.star_speed_button=child(box(230,596,280,48,BUTTON),self.root)
    self.star_speed_label=child(text(230,596,'',20,WHITE),self.root)
    self.star_speed_hint=child(text(230,560,'แตะเพื่อสลับ '..sky.STAR_SPEEDS[1]..' / '..sky.STAR_SPEEDS[2]..' หน่วย/วิ',16,MUTED),self.root)
    self.water_toggle=child(box(470,596,300,48,BUTTON),self.root)
    self.water_toggle_label=child(text(470,596,'',20,WHITE),self.root)
    self.fish_toggle=child(box(810,596,280,48,BUTTON),self.root)
    self.fish_toggle_label=child(text(810,596,'',20,WHITE),self.root)
    self.visibility_nodes={self.water_toggle,self.water_toggle_label,self.fish_toggle,self.fish_toggle_label}
    self.level_slider=slider(self.root,640,590);self.rough_slider=slider(self.root,1050,590)
    self.star_slider=slider(self.root,640,490,sky.MAX_STARS);self.dust_slider=slider(self.root,1050,490,sky.MAX_DUST)
    self.sliders={water_level=self.level_slider,water_roughness=self.rough_slider,star_count=self.star_slider,dust_count=self.dust_slider}
    child(text(1050,564,'25% = Legacy',14,MUTED),self.rough_slider.root)
    self.body=child(box(640,100,900,200,PANEL),self.root)
    for row,side in ipairs({-1,1}) do
        local y=row==1 and 146 or 66
        child(text(340,y,side==-1 and 'ซ้าย' or 'ขวา',16,MUTED),self.body)
        for step,value in ipairs(sky.angles) do
            local x=440+(step-1)*100
            local b={side=side,step=step,node=child(box(x,y,80,64,BUTTON),self.body)}
            b.label=child(text(x,y-18,angle_label(step),16),self.body)
            local a=math.rad(value)
            b.arrow=arrow(self.body,x,y+10,math.atan2(math.sin(a),side*math.cos(a)),WHITE)
            self.buttons[#self.buttons+1]=b
        end
    end
    child(text(640,12,'Space: พับแถบ · T: สลับฝั่ง · ← →: เลือกมุม',13,MUTED),self.body)
    self.header=child(box(640,28,900,56,PANEL),self.root)
    child(text(400,28,'ทิศทางลม',18,WHITE),self.header)
    self.current=child(text(730,28,'',18,WHITE),self.header)
    self.current_arrow=child(box(650,28,1,1,vmath.vector4()),self.header)
    arrow(self.current_arrow,650,28,0,ACCENT)
    self.chevron_up={line(self.header,1040,28,-7,-3,0,4,MUTED),line(self.header,1040,28,0,4,7,-3,MUTED)}
    self.chevron_down={line(self.header,1040,28,-7,3,0,-4,MUTED),line(self.header,1040,28,0,-4,7,3,MUTED)}
    local system=sys.get_sys_info().system_name
    self.touch_device=system=='Android' or system=='iPhone OS'
    if html5 and html5.run then self.touch_device=(tonumber(html5.run('navigator.maxTouchPoints || 0')) or 0)>0 end
    refresh(self)
end
function on_message(self,id,message)
    if id==hash('route') then
        self.page=message.name;self.active=self.page=='night_sky' or self.page=='night_water' or self.page=='fish_test'
        self.target='/'..(self.active and self.page or 'night_sky')..'#script'
        gui.set_text(self.title,self.page=='fish_test' and 'ฉากทดสอบปลา' or self.page=='night_water' and 'ท้องฟ้าและผิวน้ำ' or 'ท้องฟ้ากลางคืน')
        clear(self);refresh(self)
    elseif id==hash('clear_input') then clear(self)
    elseif id==hash('wind_status') and message.page==self.page then
        self.side,self.step,self.star_speed=message.side,message.step,message.star_speed
        self.water_visible=message.water_visible;self.fish_visible=message.fish_visible
        if self.slider_kind~='water_level' then self.water_level=message.water_level end
        if self.slider_kind~='water_roughness' then self.water_roughness=message.water_roughness end
        if self.slider_kind~='star_count' then self.star_count=message.star_count end
        if self.slider_kind~='dust_count' then self.dust_count=message.dust_count end
        refresh(self)
    end
end
local function button_at(self,x,y)
    if self.page=='fish_test' then
        if gui.pick_node(self.water_toggle,x,y) then return 'toggle_water' end
        if self.water_visible and gui.pick_node(self.fish_toggle,x,y) then return 'toggle_fish' end
        return
    end
    if self.page=='night_water' then
        if gui.pick_node(self.level_slider.hit,x,y) then return 'water_level' end
        if gui.pick_node(self.rough_slider.hit,x,y) then return 'water_roughness' end
    end
    if gui.pick_node(self.star_slider.hit,x,y) then return 'star_count' end
    if gui.pick_node(self.dust_slider.hit,x,y) then return 'dust_count' end
    if gui.pick_node(self.star_speed_button,x,y) then return 'star_speed' end
    if gui.pick_node(self.header,x,y) then return 'fold' end
    if not self.collapsed then
        for i,b in ipairs(self.buttons) do if gui.pick_node(b.node,x,y) then return i end end
    end
end
local function activate(self,button)
    if button=='toggle_water' or button=='toggle_fish' then msg.post(self.target,button)
    elseif button=='fold' then self.collapsed=not self.collapsed;refresh(self)
    elseif button=='star_speed' then msg.post(self.target,'toggle_star_speed')
    elseif type(button)=='number' then
        local b=self.buttons[button];select(self,b.side,b.step)
    end
end
local function pointer(self,id,a)
    if not a.x or not a.y then
        if a.released and self.slider_id==id then self.slider_id=nil;self.slider_kind=nil end
        return
    end
    local function slide()
        local hit=self.sliders[self.slider_kind].hit
        local local_point=gui.screen_to_local(hit,vmath.vector3(a.screen_x or a.x,a.screen_y or a.y,0))
        local progress=math.max(0,math.min(1,(local_point.x+115)/230))
        if self.slider_kind=='star_count' or self.slider_kind=='dust_count' then
            local maximum=self.slider_kind=='star_count' and sky.MAX_STARS or sky.MAX_DUST
            self[self.slider_kind]=math.floor(progress*maximum+.5)
            refresh(self);msg.post(self.target,self.slider_kind,{count=self[self.slider_kind]})
        elseif self.slider_kind=='water_roughness' then
            self.water_roughness=progress
            refresh(self);msg.post(self.target,'water_roughness',{roughness=progress})
        else
            self.water_level=progress
            refresh(self);msg.post(self.target,'water_level',{level=progress})
        end
    end
    if self.slider_id~=nil then
        if self.slider_id==id then slide();if a.released then self.slider_id=nil;self.slider_kind=nil end end
        return
    end
    local kind=a.pressed and button_at(self,a.x,a.y)
    if self.sliders[kind] and next(self.contacts)==nil then
        self.slider_id=id;self.slider_kind=kind;slide();return
    end
    if a.pressed then gestures.begin(self.gestures,id,a.x,a.y,button_at(self,a.x,a.y));self.contacts[id]=true end
    if not self.contacts[id] then return end
    gestures.move(self.gestures,id,a.x,a.y)
    if a.released then
        local result=gestures.finish(self.gestures,id,a.x,a.y);self.contacts[id]=nil
        if result.tap and result.tap==button_at(self,a.x,a.y) then activate(self,result.tap) end
    end
end
function on_input(self,id,a)
    if not self.active or id==hash('escape') then return false end
    if id==hash('touch') then
        self.touch_device=true;for _,finger in ipairs(a.touch or {}) do pointer(self,finger.id,finger) end;return true
    end
    if id==hash('pointer') or (id==nil and (self.contacts.mouse or self.slider_id=='mouse')) then
        if not self.touch_device then pointer(self,'mouse',a) end;return true
    end
    if a.pressed and self.page~='fish_test' then
        if id==hash('activate') then activate(self,'fold')
        elseif id==hash('turn') then select(self,-self.side,self.step)
        elseif id==hash('next_page') then select(self,self.side,math.min(5,self.step+1))
        elseif id==hash('previous_page') then select(self,self.side,math.max(1,self.step-1)) end
    end
    return true
end
