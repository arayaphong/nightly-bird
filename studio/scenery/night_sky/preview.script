local motion=require('shared.scenery.night_sky.motion')
local water=require('shared.scenery.water.motion')
go.property('with_water',false)
go.property('with_fish',false)
function init(self)
    self.motion=motion.new();self.last={};self.active=false
    self.water=water.new();self.page=self.with_fish and 'fish_test' or self.with_water and 'night_water' or 'night_sky'
    msg.post('#sky','disable')
end
local function publish(self)
    msg.post('/sky_controls#gui','wind_status',{page=self.page,side=self.motion.side,step=self.motion.step,star_speed=self.motion.star_speed,water_level=self.water.level,water_roughness=self.water.roughness})
end
function update(self,dt)
    if not self.active then return end
    local p=rive.get_projection_matrix();local w,h=2/p.m00,2/p.m11
    if w~=self.width or h~=self.height then
        self.width,self.height=w,h
        go.set_position(vmath.vector3(w/2,h/2,0))
        go.set_scale(vmath.vector3(w/480,h/800,1))
    end
    motion.step(self.motion,dt)
    if self.with_water then water.step(self.water,dt) end
    if self.with_fish then
        msg.post('/swimming_fish#script','water_frame',{dt=dt,width=w,height=h,
            level=self.water.level,roughness=self.water.roughness})
    end
    if not self.vm then self.vm=rive.get_view_model_instance('#sky') end
    if self.vm then
        local values=motion.values(self.motion)
        -- The sky fills the viewport, but the moon keeps a uniform world scale.
        local sx,sy=w/480,h/800;local uniform=math.min(sx,sy)
        values.moon_scale_x=uniform/sx;values.moon_scale_y=uniform/sy
        values.water_alpha=0
        if self.with_water then for name,value in pairs(water.values(self.water)) do values[name]=value end end
        for name,value in pairs(values) do
            if self.last[name]~=value then
                rive.cmd.setViewModelInstanceNumber(self.vm,name,value);self.last[name]=value
            end
        end
    end
end
function on_message(self,id,message)
    if id==hash('active') then
        self.active=message.active;msg.post('#sky',self.active and 'enable' or 'disable')
        if self.active then publish(self) end
    elseif id==hash('wind') and self.active then
        if motion.select(self.motion,message.side,message.step) then publish(self) end
    elseif id==hash('toggle_star_speed') and self.active then
        motion.toggle_star_speed(self.motion);publish(self)
    elseif id==hash('water_level') and self.active and self.with_water then
        if water.set_level(self.water,message.level) then publish(self) end
    elseif id==hash('water_roughness') and self.active and self.with_water then
        if water.set_roughness(self.water,message.roughness) then publish(self) end
    end
end
