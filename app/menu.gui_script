local routes=require('app.routes')
local gestures=require('shared.input.gestures')
local categories=require('studio.catalog')
local scenarios=require('scenarios.catalog')
local WHITE=vmath.vector4(.97,.97,1,1)
local MUTED=vmath.vector4(.62,.72,.85,1)
local ACCENT=vmath.vector4(.74,1,.35,1)
local PANEL=vmath.vector4(.08,.13,.21,1)
local function text(x,y,value,size,color)
    local n=gui.new_text_node(vmath.vector3(x,y,0),value)
    gui.set_font(n,'main');gui.set_scale(n,vmath.vector3(size/32,size/32,1))
    gui.set_color(n,color or WHITE);gui.set_outline(n,vmath.vector4());gui.set_shadow(n,vmath.vector4())
    return n
end
local function box(x,y,w,h,color)
    local n=gui.new_box_node(vmath.vector3(x,y,0),vmath.vector3(w,h,0));gui.set_color(n,color);return n
end
local function section(self,name,title,subtitle)
    local root=box(640,360,1280,720,vmath.vector4());self.roots[name]=root;self.buttons[name]={}
    local function add(fn,...)
        local n=fn(...);gui.set_parent(n,root,true);gui.set_inherit_alpha(n,false);return n
    end
    local function label(...) return add(text,...) end
    local function button(y,route,caption,description,x)
        x=x or 640
        local n=add(box,x,y,550,100,PANEL);self.buttons[name][route]=n
        label(x,y+16,caption,30);label(x,y-20,description,20,MUTED)
    end
    label(640,668,'NIGHTLY BIRD',36);label(640,614,title,32,ACCENT);label(640,573,subtitle,22,MUTED)
    return label,button
end
local function navigate(name) msg.post('/navigation#script','navigate',{name=name}) end
local function apply(self,name)
    self.page=name;self.gestures=gestures.new();self.contacts={}
    self.menu_page=self.roots[name]~=nil
    for key,node in pairs(self.roots) do gui.set_enabled(node,key==name) end
    local parent=routes.parent(name)
    gui.set_enabled(self.back,parent~=nil);gui.set_enabled(self.back_label,parent~=nil)
    gui.set_text(self.back_label,parent=='characters' and 'หน้ารวม' or parent=='scenery' and 'ฉาก' or parent=='studio' and 'Studio' or 'หน้าหลัก')
end
function init(self)
    self.roots={};self.buttons={};self.contacts={};self.gestures=gestures.new()
    do
        local label,button=section(self,'home','เลือกพื้นที่ทำงาน','พัฒนาส่วนประกอบ หรือทดสอบภาพรวม')
        button(370,'studio','Studio','พัฒนาและทดสอบส่วนประกอบทีละหน่วย',340)
        button(370,'scenarios','Scenarios','ทดสอบภาพรวมเป็นฉากอิสระ',940)
        button(210,'system_info','System Info','FPS · WebGL renderer · ความละเอียดที่เรนเดอร์')
        label(640,130,'1: Studio · 2: Scenarios · 3: System Info',14,MUTED)
    end
    do
        local label,button=section(self,'studio','Studio','เลือกหมวดทดสอบ')
        for i,item in ipairs(categories) do button(460-(i-1)*120,item.route,item.title,item.description) end
        label(640,100,'1–3: เลือกหมวด · Esc: หน้าหลัก',13,MUTED)
    end
    do
        local label,button=section(self,'scenarios','Scenarios','เลือกฉากทดสอบภาพรวม')
        if #scenarios==0 then
            label(640,410,'ยังไม่มีฉากทดสอบ',25)
            label(640,360,'แต่ละฉากจะเลือกเข้าได้อย่างอิสระ',17,MUTED)
            label(640,325,'เมื่อพร้อมทดสอบส่วนประกอบร่วมกัน',17,MUTED)
        else
            for i,item in ipairs(scenarios) do button(460-(i-1)*120,item.route,item.title,item.description) end
        end
    end
    do
        local label,button=section(self,'scenery','ฉากและฟิสิกส์','ฉาก · platform · การชน · state')
        button(460,'night_sky','ท้องฟ้ากลางคืน','ดาวระยิบระยับ · ฝุ่นเรืองแสง · ทิศทางลม')
        button(340,'night_water','ท้องฟ้าและผิวน้ำ','ท้องฟ้ากลางคืน · คลื่นเวกเตอร์เคลื่อนไหว')
        button(220,'fish_test','ฉากทดสอบปลา','ปลาว่ายสุ่มขึ้นลงซ้ายขวาในน้ำ')
        label(640,110,'เลือกชุดทดสอบฉาก',17,MUTED)
    end
    for _,item in ipairs({{'rules_and_items','กติกาและไอเท็ม','คุณสมบัติ · การติดตั้ง · ปฏิสัมพันธ์'}}) do
        local label=section(self,item[1],item[2],item[3])
        label(640,410,'ยังไม่มีชุดทดสอบในหมวดนี้',23)
        label(640,360,'พร้อมเพิ่มการทดสอบในขั้นถัดไป',17,MUTED)
    end
    self.back=box(76,668,112,44,vmath.vector4(.15,.23,.38,1))
    self.back_label=text(76,668,'หน้าหลัก',16)
    local system=sys.get_sys_info().system_name
    self.touch_device=system=='Android' or system=='iPhone OS'
    if html5 and html5.run then self.touch_device=(tonumber(html5.run('navigator.maxTouchPoints || 0')) or 0)>0 end
    apply(self,'home')
end
function update(self)
    -- Acquire after every GUI has initialized. Resource initialization order
    -- must not let the Studio controls swallow global back/Escape input.
    if not self.input_ready then self.input_ready=true;msg.post('.','acquire_input_focus') end
end
function on_message(self,id,message)
    if id==hash('route') then apply(self,message.name)
    elseif id==hash('clear_input') then self.gestures=gestures.new();self.contacts={} end
end
local function button_at(self,x,y)
    if routes.parent(self.page) and gui.pick_node(self.back,x,y) then return 'back' end
    for route,node in pairs(self.buttons[self.page] or {}) do if gui.pick_node(node,x,y) then return route end end
end
local function pointer(self,id,a)
    if not a.x or not a.y then return false end
    if a.pressed then
        local button=button_at(self,a.x,a.y)
        if button or self.menu_page then
            self.contacts[id]=true;gestures.begin(self.gestures,id,a.x,a.y,button)
        end
    end
    local consumed=self.contacts[id]~=nil
    if not consumed then return false end
    gestures.move(self.gestures,id,a.x,a.y)
    if a.released then
        local result=gestures.finish(self.gestures,id,a.x,a.y);self.contacts[id]=nil
        if result.tap=='back' then msg.post('/navigation#script','back')
        elseif result.tap then navigate(result.tap) end
    end
    return true
end
function on_input(self,id,a)
    if a.pressed and id==hash('escape') and routes.parent(self.page) then
        msg.post('/navigation#script','back');return true
    end
    if id==hash('touch') then
        self.touch_device=true;local consumed=false
        for _,finger in ipairs(a.touch or {}) do consumed=pointer(self,finger.id,finger) or consumed end
        return consumed or self.menu_page
    end
    if id==hash('pointer') or (id==nil and self.contacts.mouse) then
        if self.touch_device then return self.menu_page end
        return pointer(self,'mouse',a) or self.menu_page
    end
    if self.menu_page and a.pressed then
        if self.page=='home' then
            if id==hash('magnet') then navigate('studio') elseif id==hash('gun') then navigate('scenarios') elseif id==hash('helmet') then navigate('system_info') end
        elseif self.page=='studio' then
            for i,key in ipairs({'magnet','gun','helmet'}) do if id==hash(key) then navigate(categories[i].route) end end
        elseif self.page=='scenery' then
            if id==hash('magnet') then navigate('night_sky') elseif id==hash('gun') then navigate('night_water') elseif id==hash('helmet') then navigate('fish_test') end
        end
    end
    return self.menu_page
end
